{
  "name": "toigeun-game",
  "version": "1.0.0",
  "private": true,
  "description": "퇴근시간 맞히기 — Cloudflare Pages + D1 로 만든 모바일 웹앱",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:create": "wrangler d1 create toigeun-db",
    "db:init:local": "wrangler d1 execute toigeun-db --local --file=./schema.sql",
    "db:init": "wrangler d1 execute toigeun-db --remote --file=./schema.sql",
    "users": "node scripts/create-users.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
